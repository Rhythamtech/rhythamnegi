SITE='http://localhost:4321' # your site domain

# SQLite database (all site data + images live here)
SQLITE_PATH='./data/cms.db'

# CMS dashboard (/cms) bootstrap credentials.
# Used ONCE to create the account (password stored as a scrypt hash in SQLite).
# After the first boot, change them in /cms/account — the database wins.
# Recovery: npm run cms:reset-password -- <username> <password>
CMS_USERNAME='admin' # cms login username
CMS_PASSWORD='change-me' # cms login password — set a strong password before deploying!

# Optional JWT signing secret (HS256). Leave empty to auto-generate and store
# one in SQLite. Set a random 32+ char value for multi-instance deployments.
# JWT_SECRET=''

# Google tag manager / analytics setting
PUBLIC_GTAG_MEASUREMENT_ID='' # Google tag measurement ID 'G-MXXXXXXX'

# Github token setting to call github repository API with higher limit
GITHUB_PERSONAL_ACCESS_TOKEN='' # Github Personal access token 'ghp_xxxxxxxxxxxxxxxxxxxxxxxxxx'

# Gen AI assist in the CMS post editor (any OpenAI-compatible provider).
# These are FALLBACKS: values saved in CMS → AI Assist override them.
# Leave AI_API_KEY empty to disable the feature until configured in the CMS.
# Groq:      AI_BASE_URL='https://api.groq.com/openai/v1'
# OpenAI:    AI_BASE_URL='https://api.openai.com/v1'
# Ollama:    AI_BASE_URL='http://localhost:11434/v1' (AI_API_KEY can stay 'ollama')
AI_BASE_URL='https://api.groq.com/openai/v1'
AI_API_KEY='' # e.g. 'gsk-xxxxxxxxxxxxxxxx'
AI_MODEL='llama-3.3-70b-versatile'

# Encryption secret for AI keys saved via the CMS (AES-256-GCM).
# Recommended: 32+ random chars, e.g. `openssl rand -base64 48`.
# If empty, the installation's auto-generated JWT secret is used instead.
# Changing it makes previously saved AI keys unreadable (re-enter them).
# AI_SECRET=''

# Caddy reverse proxy (docker compose)
# Leave commented for http://localhost (internal cert), or set to your public hostname
# CADDY_DOMAIN='mysite.dev' # enables automatic Let's Encrypt TLS

# Blog post comment setting
GISCUS_REPO='' # giscus.app repo 'devaradise/xxxxxxxx'
GISCUS_REPO_ID='' # giscus.app repo id 'R_xxxxxxx'
GISCUS_CATEGORY='' # giscus.app category 'Comments'
GISCUS_CATEGORY_ID=''  # giscus.app category id 'DIC_xxxxxxxxxxx' 