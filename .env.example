SITE='http://localhost:4321' # your site domain

# SQLite database (all site data + images live here)
SQLITE_PATH='./data/cms.db'

# CMS dashboard (/cms) initial credentials.
# These are checked at login time — change them or keep them as the only credentials.
CMS_USERNAME='admin' # cms login username
CMS_PASSWORD='change-me' # cms login password — set a strong password before deploying!

# Google tag manager / analytics setting
PUBLIC_GTAG_MEASUREMENT_ID='' # Google tag measurement ID 'G-MXXXXXXX'

# Github token setting to call github repository API with higher limit
GITHUB_PERSONAL_ACCESS_TOKEN='' # Github Personal access token 'ghp_xxxxxxxxxxxxxxxxxxxxxxxxxx'

# Gen AI assist in the CMS post editor (any OpenAI-compatible provider).
# Leave AI_API_KEY empty to disable the feature entirely.
# Groq:      AI_BASE_URL='https://api.groq.com/openai/v1'
# OpenAI:    AI_BASE_URL='https://api.openai.com/v1'
# Ollama:    AI_BASE_URL='http://localhost:11434/v1' (AI_API_KEY can stay 'ollama')
AI_BASE_URL='https://api.groq.com/openai/v1'
AI_API_KEY='' # e.g. 'gsk_xxxxxxxxxxxxxxxx'
AI_MODEL='llama-3.3-70b-versatile'

# Blog post comment setting
GISCUS_REPO='' # giscus.app repo 'devaradise/xxxxxxxx'
GISCUS_REPO_ID='' # giscus.app repo id 'R_xxxxxxx'
GISCUS_CATEGORY='' # giscus.app category 'Comments'
GISCUS_CATEGORY_ID=''  # giscus.app category id 'DIC_xxxxxxxxxxx' 