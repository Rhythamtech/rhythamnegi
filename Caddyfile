# Reverse proxy in front of the Astro SSR container.
# The site address comes from the CADDY_DOMAIN environment variable
# (set via docker-compose.yml from your .env). Omit it and Caddy binds
# localhost:80 for quick local testing.
#
# Development (no CADDY_DOMAIN): Caddy serves an auto-generated internal
#   certificate on localhost — the browser trusts it after first visit.
# Production: set a real hostname (e.g. CADDY_DOMAIN=mysite.dev) and it
#   automatically obtains and renews a Let's Encrypt certificate.
{$CADDY_DOMAIN:localhost} {
	encode zstd gzip

	# Long-lived client assets (hashed filenames) once Astro emits them
	@static path /_astro/* /static/* /favicon* /fonts/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy app:4321 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-For {remote}
	}
}
