---
import { getProfile, getSettings, mediaUrl } from '../lib/db';
import { Image } from 'astro:assets';
import Ava from '@src/assets/img/pfp.png';

type PicSize = 'sm' | 'md' | 'lg';
interface Props {
	picSize: PicSize;
}
const { picSize } = Astro.props;

const profile = getProfile();
const settings = getSettings();
const githubUrl = settings.github_url;
const name = profile.name || settings.site_title;
const role = profile.role || settings.site_tagline;
const avatarSrc = mediaUrl(profile.avatar_media_id) || Ava.src;
---

<div class='flex gap-4 items-center leading-tight not-prose'>
	<a
		href={githubUrl}
		target='_blank'
		rel='noopener noreferrer'
		class:list={[
			'rounded-full overflow-hidden shrink-0',
			{ 'w-12 h-12': picSize === 'sm' },
			{ 'w-[70px] h-[70px]': picSize === 'md' },
			{ 'w-[90px] h-[90px]': picSize === 'lg' }
		]}
	>
		<img src={avatarSrc} alt={name} />
	</a>
	<div>
		<div>
			<a
				href={githubUrl}
				class='block font-bold text-inherit hover:text-[var(--link-color)]'
				target='_blank'
				rel='noopener noreferrer'
			>
				{name}
			</a>
		</div>
		<small class='avatar__subtitle'>{role}</small>
	</div>
</div>
