---
import { getProfile, getSettings } from '../../lib/db';
import Author from '../Author.astro';

const profile = getProfile();
const settings = getSettings();
const name = profile.name || settings.site_title;
const role = profile.role || settings.site_tagline;
const bioParagraphs = (profile.bio_md || '').split('\n').map((p) => p.trim()).filter(Boolean).slice(0, 2);
---

<div
	class='about-the-author py-4 border-b'
>
	<h3 class='font-extrabold uppercase mb-4 text-sm'>About the Author</h3>
	<Author picSize='md' />
	<div class='author-desc text-[.825rem] my-4'>
		{
			bioParagraphs.length > 0 ? (
				bioParagraphs.map((paragraph: string) => <p class='mb-3'>{paragraph}</p>)
			) : (
				<p class='mb-3'>{name} is a {role.toLowerCase()} sharing builds, learnings and notes on AI and software engineering on this blog.</p>
			)
		}
	</div>
</div>
