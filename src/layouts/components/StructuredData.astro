---
import { getProfile, getSettings } from '../../lib/db';

interface Props {
	title: string;
	description: string;
	image?: string;
	articlePublishedTime?: string;
	articleModifiedTime?: string;
	articleTags?: string[];
	ogType?: 'website' | 'article';
}

const {
	title,
	description,
	image,
	articlePublishedTime,
	articleModifiedTime,
	ogType = 'website'
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString() : 'https://rhythamnegi.com';
const canonicalURL = new URL(Astro.url.pathname, siteUrl).toString();

const settings = getSettings();
const profile = getProfile();
const personName = profile.name || settings.site_title;
const jobTitle = profile.role || settings.site_tagline;
const personImage = (profile.avatar_media_id ? `/media/${profile.avatar_media_id}` : '/favicon.png');
const sameAs = [settings.github_url, settings.linkedin_url].filter(Boolean);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": personName,
  "url": siteUrl,
  "image": new URL(personImage, siteUrl).toString(),
  "sameAs": sameAs,
  "jobTitle": jobTitle,
  "description": settings.site_description
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": personName,
  "url": siteUrl,
  "description": `${jobTitle} Portfolio & Blog`
};

const breadcrumbs = [
	{ name: "Home", item: siteUrl }
];

const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
let currentPath = siteUrl;

pathSegments.forEach((segment) => {
	currentPath = new URL(segment + '/', currentPath).toString();
	breadcrumbs.push({
		name: segment.charAt(0).toUpperCase() + segment.slice(1).replace(/-/g, ' '),
		item: currentPath
	});
});

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": breadcrumbs.map((crumb, index) => ({
		"@type": "ListItem",
		"position": index + 1,
		"name": crumb.name,
		"item": crumb.item
	}))
};

let articleSchema = null;
if (ogType === 'article') {
  articleSchema = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "image": image ? new URL(image, siteUrl).toString() : new URL(personImage, siteUrl).toString(),
    "datePublished": articlePublishedTime,
    "dateModified": articleModifiedTime || articlePublishedTime,
    "author": {
      "@type": "Person",
      "name": personName,
      "url": siteUrl
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": canonicalURL
    }
  };
}
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(websiteSchema)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
{articleSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />}
