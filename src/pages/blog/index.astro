---
import { listPosts } from '../../lib/db';
import { postViews } from '../../lib/views';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostsByYear from '../../components/PostsByYear.astro';

const title = 'All posts';
const description = 'Articles, guides, tutorials about AI and software development.';

const posts = postViews(listPosts({ publishedOnly: true }));
---

<BaseLayout
	title={title}
	description={description}
>
  <div class='container'>
    <div class="mb-10">
      <h1 class="text-3xl font-bold mb-2">{title}</h1>
      <p class="text-zinc-700 dark:text-zinc-300 text-lg">{description}</p>
    </div>
    <PostsByYear posts={posts}/>
  </div>
</BaseLayout>
