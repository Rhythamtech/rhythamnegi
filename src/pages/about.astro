---
import { getSettings, getProfile, mediaUrl, listExperience, listSkills, listEducation } from '../lib/db';
import { renderMarkdownInline } from '../lib/markdown';
import BaseLayout from '../layouts/BaseLayout.astro';
import fallbackPfp from '@src/assets/img/pfp.png';
import Prose from '../components/Prose.astro';

const settings = getSettings();
const profile = getProfile();
const avatarSrc = mediaUrl(profile.avatar_media_id) || fallbackPfp.src;

const experience = listExperience();
const skills = listSkills();
const education = listEducation();
const introHtml = (await renderMarkdownInline(settings.about_intro || '')).trim();
---

<BaseLayout
	title="About Me"
	description={settings.site_description}
>
  <div class='container'>
		<main class='prose text-lg dark:prose-invert'>
      <article>
        <div class='w-full md:flex md:items-center gap-16 mb-10'>
          <div class="text-pretty leading-9">
            <h1 class="text-4xl font-bold mb-4 italic">About Me</h1>
            <Prose>
              <div class="text-lg" set:html={introHtml} />
            </Prose>
          </div>
          <img src={avatarSrc} alt="Profile Picture" width={300}  class="rounded-3xl rotate-3 mx-4 md:mx-0 shadow-xl border-4 border-white dark:border-zinc-800"/>
        </div>
        <div>
          <h2 class="text-2xl font-bold mb-4">Experience</h2>

          {
            experience.map((exp) => (
              <div class="mb-6">
                <h3 class="text-xl font-bold">{exp.company}</h3>
                <p class="italic text-zinc-600 dark:text-zinc-400">{exp.role} | {exp.period}</p>
                <ul class="list-disc ml-6 mt-2">
                  {exp.bullets.split('\n').filter(Boolean).map((bullet: string) => <li>{bullet}</li>)}
                </ul>
              </div>
            ))
          }

          <h2 class="text-2xl font-bold mb-4 mt-10">Skills</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {
              skills.map((skill) => (
                <div>
                  <h3 class="text-lg font-bold">{skill.heading}</h3>
                  <p>{skill.items}</p>
                </div>
              ))
            }
          </div>

          <h2 class="text-2xl font-bold mb-4 mt-10">Education & Certifications</h2>
          <ul class="list-disc ml-6">
            {education.map((item) => <li>{item.title}</li>)}
          </ul>
        </div>
      </article>
    </main>
  </div>
</BaseLayout>
