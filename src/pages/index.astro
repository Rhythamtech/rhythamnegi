---
import { getSettings, getProfile, listPosts, listProjects, mediaUrl } from '../lib/db';
import { postViews, projectViews } from '../lib/views';
import { renderMarkdownInline } from '../lib/markdown';
import BaseLayout from '../layouts/BaseLayout.astro';
import fallbackBanner from '@src/assets/img/banner.png';
import fallbackPfp from '@src/assets/img/pfp.png';
import Prose from '../components/Prose.astro';
import ProjectList from '../components/ProjectList.astro'
import PostItem from '../components/PostItem.astro';

const settings = getSettings();
const profile = getProfile();
const top6Projects = projectViews(listProjects({ publishedOnly: true }) as any).slice(0, 6);
const posts = postViews(listPosts({ publishedOnly: true }) as any).slice(0, 5) as any;
const introHtml = (await renderMarkdownInline(settings.hero_intro || '')).trim();

const bannerSrc = mediaUrl(profile.banner_media_id) || bannerPath(fallbackBanner);
const avatarSrc = mediaUrl(profile.avatar_media_id) || pfpPath(fallbackPfp);

function bannerPath(imported: any) { return typeof imported === 'string' ? imported : imported.src; }
function pfpPath(imported: any) { return typeof imported === 'string' ? imported : imported.src; }
---

<BaseLayout title={settings.site_title + ' - ' + settings.site_tagline} description={settings.site_description}>
	<div class='container'>
    <div class='mb-8 rounded-3xl overflow-hidden shadow-2xl'>
      <img src={bannerSrc} alt="Banner" class="w-full h-auto object-cover max-h-[300px] md:max-h-[400px]"/>
    </div>
		<div class='w-full md:flex md:items-center gap-16 mb-10'>
      <div class="text-pretty leading-9 flex-1">
        <h1 class="text-4xl font-bold mb-4 italic">{profile.role || settings.site_tagline}</h1>
        <Prose>
          <div class="text-lg" set:html={introHtml} />
        </Prose>
      </div>
      <div class="flex-shrink-0">
        <img src={avatarSrc} alt="Profile Picture" width={300} loading="eager" class="rounded-3xl rotate-3 mx-4 md:mx-0 shadow-xl border-4 border-white dark:border-zinc-800"/>
      </div>
		</div>
		<main>
      <div class='mt-6 mb-12'>
        <div class="flex justify-between gap-2 border-b mb-1 dark:border-b-zinc-700">
          <h2 class="text-lg font-bold mb-3">Recent Posts</h2>
          <a href="/blog/" class="inline-block py-2 underline dark:prose-invert">All posts &raquo;</a>
        </div>
        <div>
          {
            posts.map((post: any) => (
              <PostItem post={post} />
            ))
          }
        </div>
        <div class="text-right">
        </div>
      </div>
      <div>
        <div class="flex justify-between gap-2 mb-1">
          <h2 class="text-lg font-bold mb-3">My Projects</h2>
          <a href="/projects/" class="inline-block py-2 underline dark:prose-invert">All projects &raquo;</a>
        </div>
        <ProjectList projects={top6Projects}/>
      </div>
		</main>
	</div>
</BaseLayout>
