---
import CmsDoc from '../../layouts/CmsDoc.astro';
import { getSessionFromContext } from '../../lib/session';
import { getProfile, getSettings, listPosts, mediaUrl } from '../../lib/db';
import PostsView from '@src/components/cms/views/posts-view';

const session = getSessionFromContext(Astro);
const sidebarDefaultOpen = Astro.cookies.get('sidebar_state')?.value !== 'false';
const settings = getSettings();
const profile = getProfile();
const posts = listPosts();

const iso = (d: Date | null) => (d ? d.toISOString() : null);
const saved = Astro.url.searchParams.get('saved');
const imported = Astro.url.searchParams.get('imported');
const skipped = Astro.url.searchParams.get('skipped');
const error = Astro.url.searchParams.get('error') || '';

const errorMessages: Record<string, string> = {
	file: 'Choose a JSON file exported from this CMS.',
	size: 'That file is too large (limit 25 MB).',
	json: 'The file is not valid JSON.',
	empty: 'The file does not contain any posts.',
	count: 'Too many posts in one file (limit 500).',
	import: 'Import failed — no posts were changed. Check the server logs.'
};

const notice =
	saved === '1'
		? 'Changes saved.'
		: saved === 'error'
			? 'Saving failed — check the server logs.'
			: imported !== null
				? `Imported ${imported} post${imported === '1' ? '' : 's'}${
						skipped && skipped !== '0' ? `, skipped ${skipped}` : ''
					}.`
				: error
					? errorMessages[error] || 'Import failed.'
					: '';

const isErrorNotice = Boolean(error);
---

<CmsDoc title='Posts'>
  <PostsView
    client:load
    user={session?.username ?? ''}
    siteTitle={settings.site_title}
    avatarUrl={mediaUrl(profile.avatar_media_id) || ''}
    defaultOpen={sidebarDefaultOpen}
    active='posts'
    notice={notice}
    isErrorNotice={isErrorNotice}
    posts={posts.map((p) => ({
      id: p.id,
      title: p.title,
      slug: p.slug,
      tags: p.tags,
      status: p.status,
      date: iso(p.pubDate),
      coverUrl: p.coverUrl
    }))}
  />
</CmsDoc>
